{
  "expo": {
    "name": "RULIVO",
    "slug": "rulivo",
    "scheme": "rulivo",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow RULIVO to record private voice review notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "app.rulivo.mobile",
      "supportsTablet": true
    }
  }
}
