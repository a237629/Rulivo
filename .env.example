# Required: local | test | staging | production
APP_ENV=local

# Required: GLOBAL | CHINA
DEPLOYMENT_REGION=GLOBAL

# Optional: debug | info | warn | error (defaults to info)
LOG_LEVEL=debug

# Optional API listen port (defaults to 3000)
API_PORT=3000
DATABASE_URL=postgresql://rulivo:rulivo@localhost:5432/rulivo?schema=public

# Authentication: replace with a random secret of at least 32 characters outside local development
AUTH_JWT_SECRET=local-only-change-this-auth-secret-1234567890
AUTH_EMAIL_DELIVERY_MODE=debug
AUTH_EMAIL_FROM=RULIVO <no-reply@rulivo.local>
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Required when AUTH_EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
